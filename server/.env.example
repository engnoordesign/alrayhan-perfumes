
# Copy this file to ".env" in the same folder to customize settings.
# If no .env file exists, the defaults below are used automatically.
 
PORT=3000
# First-time admin password only. After logging in, set your real password
# in the admin panel → tab "الأمان" (it's stored hashed in
# server/data/admin.json and from then on this line is ignored).
# If left empty, a temporary random password is printed on each start.
# NEVER upload this .env file to GitHub.
ADMIN_PASSWORD=

# Show sign-up/login codes on screen instead of sending them. This lets
# ANYONE log into ANY account — only turn it on for local testing.
DEMO_CODES=off

# Which proxy's X-Forwarded-For to trust for the visitor's IP (used by the
# attempt limits). "loopback" = nginx/Codespaces on this same machine.
TRUST_PROXY=loopback
 
# ---------------------------------------------------------
# EMAIL NOTIFICATIONS (nodemailer)
# RECOMMENDED: leave everything below empty and set the Gmail
# account + app password from the admin panel, tab "البريد".
# The panel saves them in server/data/mail-settings.json, which
# is git-ignored: never uploaded to GitHub, never lost on restart.
#
# Only if you prefer .env: fill ONE block (don't keep a second,
# empty copy of these lines — the lower copy wins and blanks it).
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
# ---------------------------------------------------------
OWNER_EMAIL=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
 
# ---------------------------------------------------------
# LIGHT AI AGENT (Ollama — a free program that runs AI models locally)
# If Ollama is running with a model installed, Light becomes a real AI
# agent. Light ONLY answers through Ollama — keep Ollama running.
# Run  npm run check-ai  to test your setup and get exact fix steps.
# ---------------------------------------------------------
 
OLLAMA_URL=http://localhost:11434

# How long Ollama keeps the model loaded between questions (-1 = always,
# so replies never wait for a cold start). Example: 24h
OLLAMA_KEEP_ALIVE=-1
 
# Which model to use. If this one isn't installed, Light automatically
# uses whichever model you DO have installed.
#   qwen2.5:3b   — recommended for most PCs, good Arabic, ~2 GB
#   qwen2.5:1.5b — about twice as fast, for slow machines (2-core codespace), ~1 GB
#   llama3.1     — larger and smarter, needs ~8 GB free RAM
OLLAMA_MODEL=qwen2.5:3b
 
# How much text the model reads at once (tokens). Light's prompts are small
# now, so 2048 is plenty and fastest (values above 4096 are capped).
OLLAMA_NUM_CTX=2048

# Longest answer Light may write (tokens). Shorter = faster replies.
OLLAMA_MAX_TOKENS=220
 
# How long to wait for an answer before giving up, in milliseconds.
# Raise this on slower computers.
OLLAMA_TIMEOUT_MS=180000

# ---------------------------------------------------------
# WHATSAPP OTP (sign-up verification codes)
# Uses the official WhatsApp Business Cloud API from Meta.
# Leave WHATSAPP_TOKEN empty to keep the on-screen demo code.
# Setup steps: see "WhatsApp verification codes" in README.md
# ---------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_TEMPLATE_LANG=ar
# true if your authentication template has a "Copy code" button (the default)
WHATSAPP_OTP_BUTTON=true
