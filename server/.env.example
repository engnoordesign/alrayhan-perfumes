
# Copy this file to ".env" in the same folder to customize settings.
# If no .env file exists, the defaults below are used automatically.
 
PORT=3000
# Choose a strong admin password. If left empty, the server generates a
# temporary random password on each start and prints it in the console.
ADMIN_PASSWORD=
 
# ---------------------------------------------------------
# EMAIL NOTIFICATIONS (nodemailer)
# When a customer places an order, a notification email is sent
# to OWNER_EMAIL. If these are left blank, orders are still saved
# normally — the email step is simply skipped.
# ---------------------------------------------------------
 
# Where new-order notifications should arrive:
OWNER_EMAIL=owner@example.com
 
# The address the email is sent *from* (often the same as SMTP_USER):
MAIL_FROM=Alrayhan Perfumes <owner@example.com>
 
# --- SMTP server settings ---
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# IMPORTANT for Gmail: your normal password will NOT work here.
# Turn on 2-Step Verification, then create an "App Password" at
# https://myaccount.google.com/apppasswords and paste it below.
 
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
 
# ---------------------------------------------------------
# LIGHT AI AGENT (Ollama — a free program that runs AI models locally)
# If Ollama is running with a model installed, Light becomes a real AI
# agent. If not, Light automatically uses its fast built-in mode.
# Run  npm run check-ai  to test your setup and get exact fix steps.
# ---------------------------------------------------------
 
OLLAMA_URL=http://localhost:11434
 
# Which model to use. If this one isn't installed, Light automatically
# uses whichever model you DO have installed.
#   qwen2.5:3b  — recommended for most PCs, good Arabic, ~2 GB
#   llama3.1    — larger and smarter, needs ~8 GB free RAM
OLLAMA_MODEL=qwen2.5:3b
 
# How much text the model can read at once (in tokens). 8192 is plenty.
OLLAMA_NUM_CTX=8192
 
# How long to wait for an answer before giving up, in milliseconds.
# Raise this on slower computers.
OLLAMA_TIMEOUT_MS=180000

# ---------------------------------------------------------
# WHATSAPP OTP (sign-up verification codes)
# Uses the official WhatsApp Business Cloud API from Meta.
# Leave WHATSAPP_TOKEN empty to keep the on-screen demo code.
# Setup steps: see "WhatsApp verification codes" in README.md
# ---------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_TEMPLATE_LANG=ar
# true if your authentication template has a "Copy code" button (the default)
WHATSAPP_OTP_BUTTON=true
